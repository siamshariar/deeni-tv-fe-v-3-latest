<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark background matching body color #09090b -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#09090b" />
        </shape>
    </item>

    <!-- Combined splash image centered with padding for responsive fit across devices -->
    <item
        android:drawable="@drawable/deeni_splash"
        android:gravity="center"
        android:insetLeft="60dp"
        android:insetRight="60dp"
        android:insetTop="100dp"
        android:insetBottom="100dp" />

</layer-list>
